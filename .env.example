# Muestra una sola banda global que identifica la experiencia como prototipo.
NEXT_PUBLIC_PROTOTYPE_MODE=1

# Mantiene cursos y soluciones fixture fuera de buscadores y datos estructurados.
# Cambiar a "verified" solo después de que ELSI apruebe todo el contenido público.
NEXT_PUBLIC_CONTENT_STATUS=fixture

# Dominio público final, sin ruta ni diagonal al final.
# La indexación sigue bloqueada mientras conserve este dominio de ejemplo.
NEXT_PUBLIC_SITE_URL=https://elsyacademy.me

# Etiquetas internas de secciones; deben permanecer apagadas en la web publica.
NEXT_PUBLIC_SECTION_LABELS=0

# Supabase público. Déjalas vacías para conservar el modo fixture local.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase recomienda la clave publishable; la clave anon antigua también es compatible.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor/worker; nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Worker interno de notificaciones; nunca se expone al navegador.
NOTIFICATIONS_WORKER_SECRET=
# Feature flag; mantener apagado hasta configurar y validar el proveedor.
NOTIFICATIONS_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_RECIPIENTS=
