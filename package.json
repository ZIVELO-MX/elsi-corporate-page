{
  "name": "elsi-corporativo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <25",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sections": "NEXT_PUBLIC_SECTION_LABELS=1 next dev",
    "build": "next build",
    "build:sections": "NEXT_PUBLIC_SECTION_LABELS=1 next build",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "smoke:course-crud": "node scripts/smoke-course-crud.mjs",
    "smoke:student-operations": "node scripts/smoke-student-operations.mjs",
    "test:checkout:compat": "pnpm build && playwright test --config=playwright.checkout.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "screenshots:capture": "pnpm build && playwright test tests/mission-screenshots.spec.ts",
    "screenshots:publish": "PUBLISH_MISSION_SCREENSHOTS=1 playwright test tests/mission-screenshots.spec.ts",
    "admin:operations:e2e": "playwright test tests/admin-operations.e2e.spec.ts",
    "cloudflare:build": "opennextjs-cloudflare build",
    "smoke:supabase-rls": "node scripts/smoke-supabase-rls.mjs",
    "smoke:stripe:test": "node scripts/smoke-stripe-test.mjs",
    "cloudflare:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "2.0.7",
    "stripe": "22.4.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.120.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
